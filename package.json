{
  "name": "muse-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal authenticated MCP bridge for controlled AI access to owned application APIs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "@modelcontextprotocol/client": "2.3.0"
  }
}
